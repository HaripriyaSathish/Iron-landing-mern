# Copy to server/.env for local development (never commit the real .env)

# Local MySQL
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=iron_landing

# On Render instead: DATABASE_URL=postgres://...  (Neon connection string). When set, it wins over DB_*.
# DATABASE_URL=

# Only for `npm run db:copy` (copies local MySQL data to Neon)
# TARGET_DATABASE_URL=

JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLIENT_URL=http://localhost:5173

# First admin, created by `npm run db:init` if no admin exists yet
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
